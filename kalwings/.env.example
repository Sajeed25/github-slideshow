# ── Required ────────────────────────────────────────────────────────────
# Your public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://kalwings.com

# PostgreSQL connection string. Hosted options: Neon, Supabase, or Postgres on a VPS.
# Managed providers usually need ?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/kalwings?sslmode=require

# Random secret, 32+ chars. Generate:  openssl rand -base64 48
AUTH_SECRET=

# Email that receives sign-in codes (Resend: https://resend.com). REQUIRED in production,
# otherwise nobody can log in. EMAIL_FROM must be on a domain you've verified there.
EMAIL_API_KEY=
EMAIL_FROM=hello@kalwings.com
# EMAIL_API_URL=   (optional: override the provider endpoint; used by tests)

# Comma-separated emails that become PLATFORM_ADMIN when they sign in (your own email).
ADMIN_EMAILS=

# ── Optional / not wired yet ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OTP_PROVIDER_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=
